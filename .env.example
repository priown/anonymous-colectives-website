# Public Supabase project settings. The anon key is safe to expose; never put
# the service-role key in this file or in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional admin mapping. The login screen still asks for username/password.
VITE_ADMIN_USERNAME=Admin
VITE_ADMIN_EMAIL=admin@anonymous-collectives.local
