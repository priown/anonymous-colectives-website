# ---------------------------------------------------------------------------
# Copy this file to `.env` (or add the VITE_* values to your GitHub Actions
# variables) and fill in real values. `.env` is git-ignored — never commit it.
# ---------------------------------------------------------------------------

# Public Supabase project settings. The anon key is safe to expose; never put
# the service-role key in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional admin mapping. The login screen still asks for username/password.
VITE_ADMIN_USERNAME=Admin
VITE_ADMIN_EMAIL=admin@anonymous-collectives.local

# Cloudinary unsigned browser uploads. Never add the API secret here.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Server-side (used by Drizzle / local scripts only, never the browser):
# Supabase Postgres connection string (transaction-mode pooler).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
